# Copy to .env and fill in real values locally. Never commit .env.

# Database — PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=""

# Auth (session signing secret, e.g. output of `openssl rand -base64 32`)
AUTH_SECRET=""

# Scheduler — Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`
# to /api/cron/reminders. Generate with `openssl rand -base64 32`.
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Development seed user only (`npm run db:seed`). Optional email, required password.
# Dev-only values — never use real credentials here and never commit them.
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""

# Email reminders (Resend). Get the API key from your Resend dashboard.
RESEND_API_KEY=""
# Sender address shown on reminder emails. Must be a sender/domain verified
# in your Resend account before sending will work.
REMINDER_FROM_EMAIL="Invoice Tracker <reminders@techpick.tech>"
